# External binary sidecars go here.
# Run `npm run download-binaries` to download them.
#
# Directory structure expected after download:
#
# binaries/
#   ffmpeg-x86_64-pc-windows-msvc.exe    # Windows x64 FFmpeg
#   ffmpeg-x86_64-apple-darwin           # macOS x64 FFmpeg  
#   ffmpeg-aarch64-apple-darwin          # macOS ARM64 FFmpeg
#   ffmpeg-x86_64-unknown-linux-gnu      # Linux x64 FFmpeg
#   tesseract-x86_64-pc-windows-msvc.exe # Windows x64 Tesseract
#   tesseract-x86_64-apple-darwin        # macOS x64 Tesseract
#   tesseract-aarch64-apple-darwin       # macOS ARM64 Tesseract
#   tesseract-x86_64-unknown-linux-gnu   # Linux x64 Tesseract
#   tessdata/                            # Tesseract language data files
#     eng.traineddata
#     chi_sim.traineddata
#     ...
